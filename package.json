{
  "name": "pi-context-tidy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Independent Pi extension for cumulative context self-editing",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/node": "^22.0.0",
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
