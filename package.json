{
  "name": "@yasuhito/clearhead",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A Pi extension that lets the LLM edit its own context to keep the next prompt lean.",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasuhito/clearhead.git"
  },
  "homepage": "https://github.com/yasuhito/clearhead",
  "bugs": {
    "url": "https://github.com/yasuhito/clearhead/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-editing"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "docs/**/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
